# Plantilla de variables. NO colocar valores reales aquí.
# Copia a .env.local (ignorado por Git) y completa con valores locales.

# --- Supabase (públicas: seguras para el navegador) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (privadas: solo servidor, NUNCA exponer al cliente) ---
SUPABASE_SECRET_KEY=

# --- Flujo de evaluación pública por token (solo servidor) ---
# Backend de persistencia del flujo público: "supabase" | "local"
NOM035_PUBLIC_EVALUATION_BACKEND=
# Peppers independientes (base64url >= 32 bytes). NO reutilizar la misma cadena.
NOM035_TOKEN_PEPPER=
NOM035_SESSION_PEPPER=
NOM035_RATE_LIMIT_PEPPER=
# Minutos de vida de la sesión de evaluación (entero 1..1440).
NOM035_EVALUATION_SESSION_MINUTES=

# --- Panel administrativo (B4.6 Auth/RBAC) ---
# Modo válido: "auth_rbac". Cualquier otro valor falla cerrado.
NOM035_ADMIN_BACKEND_MODE=auth_rbac
# Orígenes permitidos (CSV). Ej: http://localhost:3000,http://127.0.0.1:3000
NOM035_ADMIN_ALLOWED_ORIGINS=

# --- Módulos secundarios B4.5 (quejas públicas / evidencias / Storage) ---
# Backend de la queja pública confidencial: "supabase" | "local"
NOM035_PUBLIC_COMPLAINT_BACKEND=supabase
# Límite de envíos por ventana (entero >= 1). Local sugerido: 5
NOM035_COMPLAINT_RATE_LIMIT_MAX=5
# Minutos de la ventana de rate limit de quejas (entero >= 1). Local sugerido: 60
NOM035_COMPLAINT_RATE_LIMIT_WINDOW_MINUTES=60
# Bucket privado de evidencias (Storage). Local: nom035-evidence
NOM035_EVIDENCE_BUCKET=nom035-evidence
# Tamaño máximo de archivo de evidencia en bytes (1 MB..15 MB). Local: 15728640
NOM035_EVIDENCE_MAX_BYTES=15728640
# Vigencia de la URL firmada de descarga en segundos (30..300). Local: 120
NOM035_SIGNED_DOWNLOAD_SECONDS=120
