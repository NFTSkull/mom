{
  "name": "mom-nom035-local",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "npx --yes supabase start",
    "db:stop": "npx --yes supabase stop",
    "db:status": "npx --yes supabase status",
    "db:reset": "npx --yes supabase db reset --local",
    "db:test": "npx --yes supabase test db --local supabase/tests/database",
    "db:types": "npx --yes supabase gen types typescript --local > src/types/database.generated.ts",
    "db:seed:evaluation": "node scripts/seed-public-evaluation.mjs",
    "auth:seed:test": "npx --yes tsx scripts/seed-auth-test-users.ts",
    "auth:cleanup:test": "npx --yes tsx scripts/cleanup-auth-test-users.ts",
    "staging:seed:auth": "npx --yes tsx scripts/seed-staging-auth-users.ts",
    "staging:cleanup:auth": "npx --yes tsx scripts/cleanup-staging-auth-users.ts",
    "staging:seed:fixtures": "npx --yes tsx scripts/seed-staging-fixtures.ts",
    "staging:cleanup:fixtures": "npx --yes tsx scripts/cleanup-staging-fixtures.ts",
    "staging:backup:dump": "node scripts/staging-backup-dump.mjs",
    "staging:backup:restore-verify": "node scripts/staging-backup-restore-verify.mjs",
    "staging:backup:storage-verify": "node scripts/staging-storage-backup-verify.mjs",
    "workers:import:local": "npx --yes tsx scripts/local-import-workers-csv.ts",
    "workers:import:local:cleanup": "npx --yes tsx scripts/local-import-workers-csv.ts --cleanup",
    "worker:seed:local": "npx --yes tsx scripts/seed-worker-login-local.ts",
    "worker:cleanup:local": "npx --yes tsx scripts/cleanup-worker-login-local.ts",
    "guia3:seed:local": "npx --yes tsx scripts/seed-guia-iii-local.ts",
    "guia3:cleanup:local": "npx --yes tsx scripts/cleanup-guia-iii-local.ts",
    "guia3:backup:local": "node scripts/backup-guia-iii-local.mjs dump",
    "guia3:backup:verify": "node scripts/backup-guia-iii-local.mjs verify",
    "b411:seed:local": "npx --yes tsx scripts/seed-b411-workload-83-local.ts",
    "b411:cleanup:local": "npx --yes tsx scripts/cleanup-b411-workload-83-local.ts",
    "b411:certify:local": "npx --yes tsx --require ./scripts/lib/stub-server-only.cjs scripts/certify-b411-workload-83-local.ts",
    "worker:dry-run:83": "npx --yes tsx scripts/dry-run-worker-accounts-83.ts",
    "production:residue:audit": "npx --yes tsx scripts/production-residue-audit.ts",
    "production:residue:cleanup": "CONFIRM_PRODUCTION_CLEANUP=YES npx --yes tsx scripts/production-cleanup-staging-residues.ts",
    "production:backup:dump": "CONFIRM_PRODUCTION_BACKUP=YES node scripts/production-backup-dump.mjs",
    "test:e2e:staging": "playwright test -c playwright.staging.config.ts",
    "test:e2e:staging:webkit": "FORCE_STAGING_WEBKIT=1 playwright test -c playwright.staging.config.ts --project=webkit-public",
    "ci:secret-scan": "python3 scripts/ci-secret-scan.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.109.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "otpauth": "^9.5.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.0.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.8"
  }
}
